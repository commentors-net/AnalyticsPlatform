# Environment Configuration Template for Analytics Platform
# Note: For production, secrets are managed in Google Secret Manager, never in plaintext files.

ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Connection Settings
# Host port 5433 is used locally to prevent collision with other Docker services
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=analytics_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=analytics_dev_password

# Database Connection Pool Settings (COND-04)
# Bounded connection pool per worker container to support Cloud Run autoscaling
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=5
DB_POOL_TIMEOUT_SECONDS=10.0

# Administrative Authentication Settings
# In production, ANALYTICS_JWT_SECRET is mounted from Secret Manager
ANALYTICS_JWT_SECRET=dev-only-insecure-jwt-secret-do-not-use-in-production-min-32-chars
ANALYTICS_JWT_ALGORITHM=HS256
ANALYTICS_ACCESS_TOKEN_EXPIRE_MINUTES=15
ANALYTICS_REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial SuperAdmin Seed (Development bootstrap only)
SEED_SUPERADMIN_EMAIL=admin@analytics-platform.internal
SEED_SUPERADMIN_PASSWORD=AdminSecurePassword123!

# Edge & Ingestion Settings
MAX_PAYLOAD_SIZE_BYTES=65536
MAX_BATCH_SIZE_BYTES=524288
MAX_BATCH_EVENTS_COUNT=50
RATE_LIMIT_PER_IP_MINUTE=120
RATE_LIMIT_PER_KEY_MINUTE=2000
